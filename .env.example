# Funnel hand-off target. Leave UNSET in production (defaults to the live
# funnel). Locally, point at a local funnel so dev clicks don't create real
# lead rows: http://localhost:3100/challenge/audience
NEXT_PUBLIC_SCORECARD_BASE_URL=

# Canonical origin for metadata/sitemap.
NEXT_PUBLIC_SITE_URL=https://msp.aimerge.live

# Optional "Book a Call" link in the header and final CTA. Hidden when unset.
NEXT_PUBLIC_BOOKING_URL=

# Analytics. All consent-gated. The pixel id MUST match the other AI Merge
# properties (154063518466921) or ad click and Lead split across datasets.
# NEXT_PUBLIC_* values are inlined at BUILD time: set them in Vercel and
# redeploy - .env.local does not affect production.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=154063518466921
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLE_DEV=false

# Build-time: set true to enforce the CSP instead of report-only.
CSP_ENFORCE=false
